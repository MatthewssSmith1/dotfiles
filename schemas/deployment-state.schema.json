{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/deployment-state.schema.json",
  "$comment": "Documentation for the inline lean_validate_state_file validator in lib/lean_engine.sh.",
  "title": "Lean ownership state",
  "oneOf": [
    { "$ref": "#/$defs/version1" },
    { "$ref": "#/$defs/version2" }
  ],
  "$defs": {
    "baseProperties": {
      "profile": { "enum": ["omarchy", "ubuntu"] },
      "area": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "attachments": { "$ref": "#/$defs/attachments" }
    },
    "version1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "profile", "area", "attachments"],
      "properties": {
        "version": { "const": 1 },
        "profile": { "$ref": "#/$defs/baseProperties/profile" },
        "area": { "$ref": "#/$defs/baseProperties/area" },
        "attachments": { "$ref": "#/$defs/attachments", "minProperties": 1 }
      }
    },
    "version2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "profile", "area", "attachments", "resources"],
      "properties": {
        "version": { "const": 2 },
        "profile": { "$ref": "#/$defs/baseProperties/profile" },
        "area": { "$ref": "#/$defs/baseProperties/area" },
        "attachments": { "$ref": "#/$defs/attachments" },
        "resources": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/relativePath" },
          "additionalProperties": { "$ref": "#/$defs/jsonScalarResource" }
        }
      }
    },
    "attachments": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/relativePath" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "origin", "before_sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "origin": {
            "enum": ["created", "existing-empty", "existing-final-newline", "existing-no-final-newline"]
          },
          "before_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "jsonScalarResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "fields"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "kind": { "const": "json-scalar-fields" },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^/[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$" },
          "additionalProperties": { "$ref": "#/$defs/jsonScalarField" }
        }
      }
    },
    "jsonScalarField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "original", "managed"],
      "properties": {
        "type": { "enum": ["integer", "number", "string", "boolean", "null"] },
        "original": { "type": ["number", "string", "boolean", "null"] },
        "managed": { "type": ["number", "string", "boolean", "null"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "integer" } } }, "then": { "properties": { "original": { "type": "integer" }, "managed": { "type": "integer" } } } },
        { "if": { "properties": { "type": { "const": "number" } } }, "then": { "properties": { "original": { "type": "number" }, "managed": { "type": "number" } } } },
        { "if": { "properties": { "type": { "const": "string" } } }, "then": { "properties": { "original": { "type": "string" }, "managed": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "boolean" } } }, "then": { "properties": { "original": { "type": "boolean" }, "managed": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "const": "null" } } }, "then": { "properties": { "original": { "type": "null" }, "managed": { "type": "null" } } } }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+$"
    }
  }
}
