{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MatthewssSmith1/dotfiles/blob/main/schemas/agent-skills-lock.schema.json",
  "title": "Agent skills lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "repository", "commit", "package_root", "instructions", "skills"],
  "properties": {
    "$schema": { "const": "../schemas/agent-skills-lock.schema.json" },
    "schema_version": { "const": 1 },
    "repository": { "const": "https://github.com/mattpocock/skills" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "package_root": { "const": "packages/common/agents" },
    "instructions": { "$ref": "#/$defs/packageFile" },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f]+)*$"
    },
    "blob": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "packageFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "blob", "mode", "size"],
      "properties": {
        "destination": { "$ref": "#/$defs/path" },
        "blob": { "$ref": "#/$defs/blob" },
        "mode": { "const": "100644" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "destination", "blob", "mode", "size"],
      "properties": {
        "source_path": { "$ref": "#/$defs/path" },
        "destination": { "$ref": "#/$defs/path" },
        "blob": { "$ref": "#/$defs/blob" },
        "mode": { "const": "100644" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source_path", "destination", "tree", "files"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "source_path": { "$ref": "#/$defs/path" },
        "destination": { "$ref": "#/$defs/path" },
        "tree": { "$ref": "#/$defs/blob" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceFile" }
        }
      }
    }
  }
}
