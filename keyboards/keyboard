#!/usr/bin/env python3
"""Explicit, offline keyboard management; never part of dotfiles deployment."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

HERE = Path(__file__).resolve().parent
TARGETS = ("toucan", "air60", "keyd")
COMMANDS = ("status", "check", "snapshot", "diff", "apply", "verify", "reference")


def check_snapshots():
    root = HERE / "snapshots"
    lines = (root / "SHA256SUMS").read_text().splitlines()
    if not lines:
        raise ValueError("Original snapshot manifest is empty")
    for line in lines:
        expected, name = line.split()
        path = root / name
        if not path.resolve().is_relative_to(root.resolve()):
            raise ValueError("Snapshot manifest path escapes snapshot directory")
        if hashlib.sha256(path.read_bytes()).hexdigest() != expected:
            raise ValueError(f"Original snapshot hash mismatch: {name}")


def save_snapshot(target, data):
    # Device backends print JSON; retain successful reads privately, never in git.
    json.loads(data)
    state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
    root = state / "keyboards" / target
    if root.resolve().is_relative_to(HERE.parent):
        raise ValueError("Runtime snapshots must be outside the repository")
    root.mkdir(parents=True, mode=0o700, exist_ok=True)
    info = root.stat()
    if root.is_symlink() or info.st_uid != os.geteuid() or info.st_mode & 0o077:
        raise ValueError(f"Snapshot directory must be private and owned by you: {root}")
    run = Path(tempfile.mkdtemp(prefix="snapshot-", dir=root))
    path = run / "snapshot.json"
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    return path


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, epilog=
        "Backend options follow the target. Use COMMAND TARGET --help for details. "
        "No build, flash, reset, or implicit elevation operations exist.")
    parser.add_argument("command", choices=COMMANDS, nargs="?")
    parser.add_argument("target", choices=TARGETS, nargs="?")
    argv = list(sys.argv[1:] if argv is None else argv)
    # Preserve target-specific help rather than consuming it in the wrapper.
    if len(argv) >= 3 and argv[0] in COMMANDS and argv[1] in TARGETS and "--help" in argv[2:]:
        return subprocess.run([sys.executable, "-B", str(HERE / argv[1] / "backend.py"),
                               argv[0], "--help"], check=False).returncode
    args, options = parser.parse_known_args(argv)
    try:
        if args.command is None:
            if options:
                parser.error("unrecognized arguments: " + " ".join(options))
            parser.print_help()
            return 0
        if os.geteuid() == 0 and (args.command, args.target) != ("apply", "keyd"):
            raise ValueError("Run as your normal user; only explicit apply keyd accepts root")
        if args.command == "reference":
            if args.target or options:
                parser.error("reference takes no target or options")
            print(HERE / "reference.html", flush=True)
            return subprocess.run(["xdg-open", str(HERE / "reference.html")], check=False).returncode
        if not args.target and (args.command not in ("check", "status") or options):
            parser.error("this command requires an explicit target")
        if args.command == "apply" and not Path("/usr/share/omarchy").is_dir():
            raise ValueError("Keyboard apply is supported on Omarchy machines only")
        if args.command in ("check", "apply"):
            check_snapshots()
        result = 0
        for target in (args.target,) if args.target else TARGETS:
            if not args.target:
                print(f"[{target}]", flush=True)
            command = [sys.executable, "-B", str(HERE / target / "backend.py"),
                       args.command, *options]
            if args.command == "snapshot" and target != "keyd":
                completed = subprocess.run(command, stdout=subprocess.PIPE, text=True, check=False)
                if completed.returncode == 0:
                    print(save_snapshot(target, completed.stdout))
            else:
                completed = subprocess.run(command, check=False)
            if completed.returncode:
                result = 1
        return result
    except (OSError, ValueError) as exc:
        print(f"keyboard: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
