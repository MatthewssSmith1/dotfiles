#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_NAME="${0##*/}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
readonly REPO_DIR
readonly PACKAGE_ROOT="$REPO_DIR/packages/common/agents"

die() {
  printf '[%s] error: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

frontmatter_name() {
  local file="$1" line='' name='' count=0 first=true closed=false
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$first" == true ]]; then
      [[ "$line" == '---' ]] || return 1
      first=false
      continue
    fi
    if [[ "$line" == '---' ]]; then
      closed=true
      break
    fi
    if [[ "$line" == name:* ]]; then
      name="${line#name:}"
      name="${name# }"
      ((count += 1))
    fi
  done < "$file"
  [[ "$closed" == true && "$count" == 1 && "$name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || return 1
  printf '%s' "$name"
}

# Lighter discoverability check for repo-level skills: each SKILL.md carries
# well-formed frontmatter whose name matches its directory and a nonempty
# single-line description. Payload layout is not constrained (these skills
# keep companion documents beside SKILL.md).
verify_repo_skill_frontmatter() {
  local file="$1" line='' description='' count=0 first=true closed=false
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$first" == true ]]; then
      [[ "$line" == '---' ]] || return 1
      first=false
      continue
    fi
    if [[ "$line" == '---' ]]; then
      closed=true
      break
    fi
    if [[ "$line" == description:* ]]; then
      description="${line#description:}"
      description="${description# }"
      ((count += 1))
    fi
  done < "$file"
  [[ "$closed" == true && "$count" == 1 && -n "$description" ]] || return 1
}

verify_repo_skills() {
  local skills_root="$REPO_DIR/.agents/skills"
  local entry skill name repo_skill_count=0

  [[ -d "$skills_root" && ! -L "$skills_root" ]] || die 'repo .agents/skills is missing or not a directory'
  for entry in "$skills_root"/*; do
    [[ -d "$entry" && ! -L "$entry" ]] || die "repo skill entry is not a directory: ${entry#"$REPO_DIR"/}"
    skill="${entry##*/}"
    [[ "$skill" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "invalid repo skill directory name: $skill"
    [[ -f "$entry/SKILL.md" && ! -L "$entry/SKILL.md" ]] || die "missing or non-regular skill file: .agents/skills/$skill/SKILL.md"
    name="$(frontmatter_name "$entry/SKILL.md")" || die "invalid SKILL.md frontmatter: .agents/skills/$skill/SKILL.md"
    [[ "$name" == "$skill" ]] || die "frontmatter name does not match repo skill directory: $skill"
    verify_repo_skill_frontmatter "$entry/SKILL.md" ||
      die "SKILL.md frontmatter lacks a single nonempty description line: .agents/skills/$skill/SKILL.md"
    ((repo_skill_count += 1))
  done
  ((repo_skill_count > 0)) || die 'repository must contain at least one repo skill directory'
  printf '[%s] verified %s repository skills\n' "$SCRIPT_NAME" "$repo_skill_count"
}

verify() {
  local agents_root="$PACKAGE_ROOT/.agents" skills_root="$PACKAGE_ROOT/.agents/skills"
  local claude_root="$PACKAGE_ROOT/.claude" claude_skills_root="$PACKAGE_ROOT/.claude/skills"
  local entry relative skill name file_count=0 skill_count=0 claude_skill_count=0 codex_profile_count=0
  declare -A universal_skills=()

  [[ -d "$PACKAGE_ROOT" && ! -L "$PACKAGE_ROOT" ]] || die 'package root is missing or not a directory'
  [[ -d "$agents_root" && ! -L "$agents_root" ]] || die 'package .agents is missing or not a directory'
  [[ -d "$skills_root" && ! -L "$skills_root" ]] || die 'package .agents/skills is missing or not a directory'
  [[ -f "$agents_root/AGENTS.md" && ! -L "$agents_root/AGENTS.md" ]] ||
    die 'canonical .agents/AGENTS.md is missing or not a regular file'

  shopt -s dotglob nullglob
  for entry in "$skills_root"/*; do
    [[ -d "$entry" && ! -L "$entry" ]] || die "direct skill entry is not a directory: ${entry#"$PACKAGE_ROOT"/}"
    skill="${entry##*/}"
    [[ "$skill" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "invalid skill directory name: $skill"
    [[ -f "$entry/SKILL.md" && ! -L "$entry/SKILL.md" ]] || die "missing or non-regular skill file: .agents/skills/$skill/SKILL.md"
    name="$(frontmatter_name "$entry/SKILL.md")" || die "invalid SKILL.md frontmatter: .agents/skills/$skill/SKILL.md"
    [[ "$name" == "$skill" ]] || die "frontmatter name does not match skill directory: $skill"
    universal_skills["$skill"]=1
    ((skill_count += 1))
  done
  ((skill_count > 0)) || die 'package must contain at least one direct skill directory'

  [[ -d "$claude_root" && ! -L "$claude_root" ]] || die 'package .claude is missing or not a directory'
  [[ -d "$claude_skills_root" && ! -L "$claude_skills_root" ]] || die 'package .claude/skills is missing or not a directory'
  for entry in "$claude_skills_root"/*; do
    [[ -d "$entry" && ! -L "$entry" ]] || die "direct Claude skill entry is not a directory: ${entry#"$PACKAGE_ROOT"/}"
    skill="${entry##*/}"
    [[ "$skill" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ && "$skill" != synced ]] || die "invalid Claude skill directory name: $skill"
    [[ -z "${universal_skills[$skill]+x}" ]] || die "Claude skill conflicts with universal skill: $skill"
    [[ -f "$entry/SKILL.md" && ! -L "$entry/SKILL.md" ]] || die "missing or non-regular skill file: .claude/skills/$skill/SKILL.md"
    name="$(frontmatter_name "$entry/SKILL.md")" || die "invalid SKILL.md frontmatter: .claude/skills/$skill/SKILL.md"
    [[ "$name" == "$skill" ]] || die "frontmatter name does not match Claude skill directory: $skill"
    ((claude_skill_count += 1))
  done
  ((claude_skill_count > 0)) || die 'package must contain at least one direct Claude skill directory'

  shopt -s globstar
  for entry in "$PACKAGE_ROOT"/**; do
    relative="${entry#"$PACKAGE_ROOT"/}"
    [[ -n "$relative" ]] || continue
    if [[ -L "$entry" ]]; then
      die "package payload symlink is forbidden: $relative"
    elif [[ -d "$entry" ]]; then
      [[ "$relative" == .agents || "$relative" == .agents/skills || "$relative" == .agents/skills/* ||
        "$relative" == .claude || "$relative" == .claude/skills || "$relative" == .claude/skills/* ||
        "$relative" == .codex ]] ||
        die "package payload is outside managed skill roots: $relative"
    elif [[ -f "$entry" ]]; then
      [[ "$relative" == .agents/AGENTS.md || "$relative" == .agents/skills/*/* ||
        "$relative" == .claude/skills/*/* || "$relative" == .codex/*.config.toml ]] ||
        die "package file is outside managed Agents payload: $relative"
      [[ "$(stat -c '%a' -- "$entry")" == 644 ]] || die "unexpected package file mode: $relative"
      [[ "$relative" != .codex/* ]] || ((codex_profile_count += 1))
      ((file_count += 1))
    else
      die "unsupported package object: $relative"
    fi
  done
  shopt -u dotglob nullglob globstar

  printf '[%s] verified %s universal skills, %s Claude skills, %s Codex profiles, and %s package files\n' \
    "$SCRIPT_NAME" "$skill_count" "$claude_skill_count" "$codex_profile_count" "$file_count"
}

case "${1:-}" in
  verify)
    (($# == 1)) || die "usage: $SCRIPT_NAME verify"
    verify
    verify_repo_skills
    ;;
  *) die "usage: $SCRIPT_NAME verify" ;;
esac
