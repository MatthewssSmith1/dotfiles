#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_NAME="${0##*/}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
readonly REPO_DIR
readonly PACKAGE_ROOT="$REPO_DIR/packages/common/agents"

die() {
  printf '[%s] error: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

frontmatter_name() {
  local file="$1" line='' name='' count=0 first=true closed=false
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$first" == true ]]; then
      [[ "$line" == '---' ]] || return 1
      first=false
      continue
    fi
    if [[ "$line" == '---' ]]; then
      closed=true
      break
    fi
    if [[ "$line" == name:* ]]; then
      name="${line#name:}"
      name="${name# }"
      ((count += 1))
    fi
  done < "$file"
  [[ "$closed" == true && "$count" == 1 && "$name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || return 1
  printf '%s' "$name"
}

verify() {
  local agents_root="$PACKAGE_ROOT/.agents" skills_root="$PACKAGE_ROOT/.agents/skills"
  local entry relative skill name file_count=0 skill_count=0

  [[ -d "$PACKAGE_ROOT" && ! -L "$PACKAGE_ROOT" ]] || die 'package root is missing or not a directory'
  [[ -d "$agents_root" && ! -L "$agents_root" ]] || die 'package .agents is missing or not a directory'
  [[ -d "$skills_root" && ! -L "$skills_root" ]] || die 'package .agents/skills is missing or not a directory'
  [[ -f "$agents_root/AGENTS.md" && ! -L "$agents_root/AGENTS.md" ]] ||
    die 'canonical .agents/AGENTS.md is missing or not a regular file'

  shopt -s dotglob nullglob
  for entry in "$skills_root"/*; do
    [[ -d "$entry" && ! -L "$entry" ]] || die "direct skill entry is not a directory: ${entry#"$PACKAGE_ROOT"/}"
    skill="${entry##*/}"
    [[ "$skill" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "invalid skill directory name: $skill"
    [[ -f "$entry/SKILL.md" && ! -L "$entry/SKILL.md" ]] || die "missing or non-regular skill file: .agents/skills/$skill/SKILL.md"
    name="$(frontmatter_name "$entry/SKILL.md")" || die "invalid SKILL.md frontmatter: .agents/skills/$skill/SKILL.md"
    [[ "$name" == "$skill" ]] || die "frontmatter name does not match skill directory: $skill"
    ((skill_count += 1))
  done
  ((skill_count > 0)) || die 'package must contain at least one direct skill directory'

  shopt -s globstar
  for entry in "$PACKAGE_ROOT"/**; do
    relative="${entry#"$PACKAGE_ROOT"/}"
    [[ -n "$relative" ]] || continue
    if [[ -L "$entry" ]]; then
      die "package payload symlink is forbidden: $relative"
    elif [[ -d "$entry" ]]; then
      [[ "$relative" == .agents || "$relative" == .agents/skills || "$relative" == .agents/skills/* ]] ||
        die "package payload is outside .agents: $relative"
    elif [[ -f "$entry" ]]; then
      [[ "$relative" == .agents/AGENTS.md || "$relative" == .agents/skills/*/* ]] ||
        die "package file is outside managed Agents payload: $relative"
      [[ "$(stat -c '%a' -- "$entry")" == 644 ]] || die "unexpected package file mode: $relative"
      ((file_count += 1))
    else
      die "unsupported package object: $relative"
    fi
  done
  shopt -u dotglob nullglob globstar

  printf '[%s] verified %s managed skills and %s package files\n' "$SCRIPT_NAME" "$skill_count" "$file_count"
}

case "${1:-}" in
  verify)
    (($# == 1)) || die "usage: $SCRIPT_NAME verify"
    verify
    ;;
  *) die "usage: $SCRIPT_NAME verify" ;;
esac
