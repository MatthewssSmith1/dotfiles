#!/usr/bin/env bash

set -Eeuo pipefail

profile="${1:-}"
shift || true
case "$profile" in
  work|personal) ;;
  *) printf 'opencode-launch: expected profile work or personal\n' >&2; exit 2 ;;
esac

config="$HOME/.config/dotfiles/opencode/$profile.jsonc"
[[ -f "$config" ]] || { printf 'opencode-launch: managed profile is absent: %s\n' "$config" >&2; exit 1; }
tui_config="$HOME/.config/dotfiles/opencode/tui.jsonc"
[[ -f "$tui_config" ]] || { printf 'opencode-launch: managed TUI config is absent: %s\n' "$tui_config" >&2; exit 1; }

# Ubuntu output is optional. Native Omarchy keeps its keybinding-only overlay.
theme_root="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/theme/ubuntu/current"
if [[ -x "$HOME/.local/bin/dotfiles-theme" && -f "$theme_root/opencode-tui.json" &&
      -f "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/themes/dotfiles-host.json" ]] &&
   [[ "$("$HOME/.local/bin/dotfiles-theme" host)" == ubuntu ]]; then
  tui_config="$theme_root/opencode-tui.json"
fi

IFS=: read -r -a path_entries <<< "${PATH:-}"
for directory in "${path_entries[@]}"; do
  [[ -n "$directory" ]] || directory=.
  candidate="$directory/opencode"
  [[ -f "$candidate" && -x "$candidate" ]] || continue
  OPENCODE_DISABLE_CLAUDE_CODE=1 OPENCODE_CONFIG="$config" OPENCODE_TUI_CONFIG="$tui_config" exec "$candidate" "$@"
done

printf 'opencode-launch: no opencode executable found on PATH\n' >&2
exit 127
