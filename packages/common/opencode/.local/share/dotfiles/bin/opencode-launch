#!/usr/bin/env bash

set -Eeuo pipefail

profile="${1:-}"
shift || true
case "$profile" in
  work|personal) ;;
  *) printf 'opencode-launch: expected profile work or personal\n' >&2; exit 2 ;;
esac

config="$HOME/.config/opencode/profiles/$profile.jsonc"
[[ -f "$config" ]] || { printf 'opencode-launch: managed profile is absent: %s\n' "$config" >&2; exit 1; }

managed="$(readlink -f -- "$HOME/.local/bin/opencode" 2>/dev/null || true)"
IFS=: read -r -a path_entries <<< "${PATH:-}"
for directory in "${path_entries[@]}"; do
  [[ -n "$directory" ]] || directory=.
  candidate="$directory/opencode"
  [[ -f "$candidate" && -x "$candidate" ]] || continue
  resolved="$(readlink -f -- "$candidate" 2>/dev/null || true)"
  [[ -n "$resolved" && "$resolved" != "$managed" ]] || continue
  OPENCODE_CONFIG="$config" exec "$candidate" "$@"
done

printf 'opencode-launch: no unmanaged opencode executable found on PATH\n' >&2
exit 127
