{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "codex": "deny",
      "codex *": "deny",
      "*/codex": "deny",
      "*/codex *": "deny"
    }
  },
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-sol",
      "variant": "low"
    },
    "general": {
      "model": "openai/gpt-5.6-sol",
      "variant": "low"
    },
    "compaction": {
      "model": "openai/gpt-5.6-terra",
      "variant": "low"
    }
  }
}
