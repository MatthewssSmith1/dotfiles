{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "codex": "deny",
      "codex *": "deny",
      "*/codex": "deny",
      "*/codex *": "deny"
    }
  },
  "agent": {
    "explore": {
      "model": "openai/gpt-6-sol-fast",
      "variant": "low"
    },
    "general": {
      "model": "openai/gpt-6-sol-fast",
      "variant": "low"
    },
    "compaction": {
      "model": "openai/gpt-6-luna-fast",
      "variant": "low"
    },
    "title": {
      "model": "openai/gpt-6-luna",
      "variant": "low"
    }
  }
}
