{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "codex": "deny",
      "codex *": "deny",
      "*/codex": "deny",
      "*/codex *": "deny"
    },
    "posthog_*": "deny"
  },
  "mcp": {
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp",
      "enabled": true
    }
  },
  "enabled_providers": [
    "openai",
    "truefoundry-gateway"
  ],
  "provider": {
    "truefoundry-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TrueFoundry",
      "options": {
        "baseURL": "https://tfy.promptlens.trilogy.com",
        "apiKey": "{env:TFY_API_KEY}"
      },
      "models": {
        "claude-group/claude-fable-5": {
          "name": "Claude Fable 5",
          "reasoning": true,
          "options": { "reasoningEffort": "medium" },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "claude-group/claude-opus-5": {
          "name": "Claude Opus 5",
          "reasoning": true,
          "options": { "reasoningEffort": "medium" },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "claude-group/claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "reasoning": true,
          "options": { "reasoningEffort": "medium" },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "glm-5p3": {
          "name": "GLM 5.3"
        }
      }
    }
  },
  "agent": {
    "explore": {
      "model": "openai/gpt-6-sol-fast",
      "variant": "low"
    },
    "general": {
      "model": "openai/gpt-6-sol-fast",
      "variant": "low"
    },
    "compaction": {
      "model": "openai/gpt-6-luna-fast",
      "variant": "low"
    },
    "title": {
      "model": "openai/gpt-6-luna",
      "variant": "low"
    },
    "posthog": {
      "description": "PostHog specialist. Use proactively for any task that touches PostHog.",
      "mode": "subagent",
      "model": "openai/gpt-6-sol-fast",
      "variant": "low",
      "permission": {
        "posthog_*": "allow",
        "edit": "deny"
      },
      "prompt": "You run PostHog work delegated by a parent agent; your reply is its only view of what you found.\nStay read-only unless the task explicitly requests a change in PostHog.\nWhen the request is ambiguous, pick the most sensible reading and state it.\nReply with a brief:\n- Answer: result and key numbers.\n- Basis: one line with project, events/properties, filters, time window, exclusions.\n- Caveats: sampling, incomplete data, schema assumptions.\n- Links: existing insights or recordings worth opening.\nShare HogQL on request, or when a failed task leaves the query as the useful artifact."
    }
  }
}
