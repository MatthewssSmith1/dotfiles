{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "codex": "deny",
      "codex *": "deny",
      "*/codex": "deny",
      "*/codex *": "deny"
    }
  },
  "enabled_providers": [
    "openai",
    "truefoundry-gateway"
  ],
  "provider": {
    "truefoundry-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TrueFoundry",
      "options": {
        "baseURL": "https://tfy.promptlens.trilogy.com",
        "apiKey": "{env:TFY_API_KEY}"
      },
      "models": {
        "claude-group/claude-fable-5": {
          "name": "Claude Fable 5",
          "reasoning": true,
          "options": { "reasoningEffort": "medium" },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "claude-group/claude-opus-5": {
          "name": "Claude Opus 5",
          "reasoning": true,
          "options": { "reasoningEffort": "medium" },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "claude-group/claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "reasoning": true,
          "options": { "reasoningEffort": "medium" },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "glm-5p3": {
          "name": "GLM 5.3"
        }
      }
    }
  },
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-sol",
      "variant": "low"
    },
    "general": {
      "model": "openai/gpt-5.6-sol",
      "variant": "low"
    },
    "compaction": {
      "model": "openai/gpt-5.6-terra",
      "variant": "low"
    }
  }
}
