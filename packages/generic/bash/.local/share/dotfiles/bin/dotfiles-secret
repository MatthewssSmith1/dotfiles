#!/usr/bin/env bash

set -Eeuo pipefail
set +x

readonly SCRIPT_NAME="${0##*/}"
readonly MAX_BUNDLE_SIZE=65536
readonly MAX_ASSIGNMENTS=256

usage() {
  printf 'usage: %s exec-env <bundle-name> -- <command> [args...]\n' "$SCRIPT_NAME" >&2
  printf '       %s check-env <bundle-name>\n' "$SCRIPT_NAME" >&2
  exit 64
}

fail() {
  local status="$1"
  shift
  printf '%s: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit "$status"
}

valid_bundle_name() {
  local LC_ALL=C
  [[ ${#1} -le 128 && "$1" != . && "$1" != .. && "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

safe_directory() {
  local path="$1" required_mode="${2:-}" mode
  [[ -d "$path" && ! -L "$path" ]] || return 1
  [[ "$(realpath -m -s -- "$path")" == "$path" && "$(realpath -e -- "$path")" == "$path" ]] || return 1
  [[ "$(stat -c %u -- "$path")" == "$EUID" ]] || return 1
  mode="$(stat -c %a -- "$path")"
  if [[ -n "$required_mode" ]]; then
    [[ "$mode" == "$required_mode" ]]
  else
    (((8#$mode & 022) == 0))
  fi
}

validate_bundle_path() {
  local current component
  safe_directory "$HOME" || return 1
  current="$HOME"
  for component in .config dotfiles local; do
    current="$current/$component"
    safe_directory "$current" || return 1
  done
  safe_directory "$SECRETS_DIRECTORY" 700 || return 1
  [[ "$(realpath -m -s -- "$BUNDLE_PATH")" == "$BUNDLE_PATH" ]] || return 1
  [[ -f "$BUNDLE_PATH" && ! -L "$BUNDLE_PATH" && -r "$BUNDLE_PATH" ]] || return 1
  [[ "$(realpath -e -- "$BUNDLE_PATH")" == "$BUNDLE_PATH" ]] || return 1
  [[ "$(stat -c %u -- "$BUNDLE_PATH")" == "$EUID" && "$(stat -c %a -- "$BUNDLE_PATH")" == 600 ]]
}

file_identity() {
  stat -Lc '%d:%i:%s:%y:%z' -- "$1"
}

clear_parser_state() {
  unset line name value identity_before identity_after assignment_count
  unset ASSIGNMENT_NAMES ASSIGNMENT_VALUES SEEN_NAMES PUBLICATIONS
}

trap 'clear_parser_state' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

(($# >= 1)) || usage
operation="$1"
shift
case "$operation" in
  exec-env)
    (($# >= 3)) || usage
    bundle_name="$1"
    [[ "$2" == -- ]] || usage
    shift 2
    (($# > 0)) || usage
    ;;
  check-env)
    (($# == 1)) || usage
    bundle_name="$1"
    ;;
  *) usage ;;
esac
valid_bundle_name "$bundle_name" || fail 64 'invalid bundle name'

[[ -n "${HOME:-}" && "$HOME" == /* ]] || fail 78 'HOME is unsafe'
readonly SECRETS_DIRECTORY="$HOME/.config/dotfiles/local/secrets"
readonly BUNDLE_PATH="$SECRETS_DIRECTORY/$bundle_name.env"
validate_bundle_path || fail 78 'environment bundle path is missing or unsafe'

exec {bundle_fd}< "$BUNDLE_PATH" || fail 66 'environment bundle is unreadable'
identity_before="$(file_identity "/proc/self/fd/$bundle_fd")"
[[ "$identity_before" == "$(file_identity "$BUNDLE_PATH")" ]] || \
  fail 78 'environment bundle changed before reading'
bundle_size="$(stat -Lc %s -- "/proc/self/fd/$bundle_fd")"
[[ "$bundle_size" =~ ^[0-9]+$ && "$bundle_size" -gt 0 && "$bundle_size" -le "$MAX_BUNDLE_SIZE" ]] || \
  fail 65 'environment bundle size is invalid'

LC_ALL=C tr -d '\012\040-\377' <&"$bundle_fd" | cmp -s -- /dev/null - || \
  fail 65 'environment bundle contains prohibited control bytes'
exec {bundle_fd}<&-
exec {bundle_fd}< "$BUNDLE_PATH" || fail 66 'environment bundle is unreadable'
[[ "$identity_before" == "$(file_identity "/proc/self/fd/$bundle_fd")" ]] || \
  fail 78 'environment bundle changed before parsing'

declare -a ASSIGNMENT_NAMES=() ASSIGNMENT_VALUES=()
declare -A SEEN_NAMES=()
assignment_count=0
while IFS= read -r line <&"$bundle_fd" || [[ -n "$line" ]]; do
  [[ -n "$line" ]] || continue
  [[ "$line" != \#* ]] || continue
  [[ "$line" == *=* ]] || fail 65 'environment bundle has a malformed row'
  name="${line%%=*}"
  value="${line#*=}"
  [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || fail 65 'environment bundle has an invalid assignment name'
  [[ -z "${SEEN_NAMES[$name]+x}" ]] || fail 65 'environment bundle has a duplicate assignment'
  ((assignment_count += 1))
  ((assignment_count <= MAX_ASSIGNMENTS)) || fail 65 'environment bundle has too many assignments'
  SEEN_NAMES["$name"]=1
  ASSIGNMENT_NAMES+=("$name")
  ASSIGNMENT_VALUES+=("$value")
done
((assignment_count > 0)) || fail 65 'environment bundle has no assignments'

identity_after="$(file_identity "/proc/self/fd/$bundle_fd")"
exec {bundle_fd}<&-
validate_bundle_path || fail 78 'environment bundle path changed or became unsafe'
[[ "$identity_before" == "$identity_after" && "$identity_after" == "$(file_identity "$BUNDLE_PATH")" ]] || \
  fail 78 'environment bundle changed while reading'

if [[ "$operation" == check-env ]]; then
  clear_parser_state
  trap - EXIT INT TERM
  printf '%s\n' valid
  exit 0
fi

command_name="$1"
shift
command_path="$(type -P -- "$command_name" 2>/dev/null || true)"
[[ -n "$command_path" && -x "$command_path" && ! -d "$command_path" ]] || fail 69 'command is unavailable'
if [[ "$command_path" != /* ]]; then command_path="$PWD/${command_path#./}"; fi
validate_bundle_path || fail 78 'environment bundle path changed or became unsafe'
[[ "$identity_after" == "$(file_identity "$BUNDLE_PATH")" ]] || fail 78 'environment bundle changed before execution'

declare -a PUBLICATIONS=()
for index in "${!ASSIGNMENT_NAMES[@]}"; do PUBLICATIONS+=("${ASSIGNMENT_NAMES[index]}=${ASSIGNMENT_VALUES[index]}"); done
set -- "${PUBLICATIONS[@]}" -- "$command_path" "$@"
clear_parser_state
trap - EXIT INT TERM
while [[ "$1" != -- ]]; do
  export "$1" 2>/dev/null || fail 65 'environment bundle assignment cannot be exported'
  shift
done
shift
exec "$@"
